    "validate": true,
    "validation_workers": 48,
    "connect_timeout": 6,
    "read_timeout": 10,
    "validation_retries": 2,
    "validation_time_budget_seconds": 1200,
    "recheck_ok_minutes": 90,
    "failure_threshold": 3,
    "drop_failed_channels": false,
    "embed_alternatives_in_master": false,
    "proxy_base_url": "",
